# Loopin k6 local defaults. Do not commit real secrets.
BASE_URL=http://localhost:8080
API_PREFIX=/api
TARGET_ENV=local

# Optional auth. AUTH_TOKEN is preferred for repeatable local/CI tests.
AUTH_TOKEN=
GOOGLE_ID_TOKEN=
REQUIRE_AUTH=false

# Optional known IDs for detail endpoints.
PUBLIC_EVENT_ID=
PUBLIC_GROUP_ID=
AUTH_GROUP_ID=

# Mutating flows are opt-in and blocked for production targets.
RUN_MUTATING_FLOWS=false
ALLOW_PRODUCTION_TARGET=false

# Smoke tuning.
SMOKE_VUS=1
SMOKE_DURATION=1m

# Load tuning.
LOAD_RAMP_UP=2m
LOAD_STEADY_VUS=20
LOAD_STEADY_DURATION=5m
LOAD_RAMP_DOWN=1m

# Stress tuning.
STRESS_RAMP_UP=4m
STRESS_TARGET_VUS=80
STRESS_HOLD_DURATION=8m
STRESS_RAMP_DOWN=2m

# Spike tuning.
SPIKE_BASELINE_VUS=5
SPIKE_PEAK_VUS=120
SPIKE_WARM_UP=1m
SPIKE_RAMP_UP=30s
SPIKE_HOLD_DURATION=1m
SPIKE_RAMP_DOWN=30s
SPIKE_RECOVERY_DURATION=2m
SPIKE_COOL_DOWN=30s

# Shared thresholds.
HTTP_TIMEOUT=10s
P95_THRESHOLD_MS=750
P99_THRESHOLD_MS=1500
ERROR_RATE_THRESHOLD=0.01
CHECK_RATE_THRESHOLD=0.95

# Optional k6 summary JSON written by handleSummary.
SUMMARY_JSON=