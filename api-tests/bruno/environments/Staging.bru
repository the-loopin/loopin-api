  google_id_token: <paste-staging-google-id-token-locally>

  event_id: 11111111-1111-4111-8111-111111111111
  group_id: 22222222-2222-4222-8222-222222222222
  join_request_id: 33333333-3333-4333-8333-333333333333
  chat_group_id: 1
  interest_id: 44444444-4444-4444-8444-444444444444

  media_id: 55555555-5555-4555-8555-555555555555
  event_image_media_id: 66666666-6666-4666-8666-666666666666
  profile_avatar_media_id: 77777777-7777-4777-8777-777777777777
  group_image_media_id: 88888888-8888-4888-8888-888888888888

  upload_url: <set-by-media-upload-request>
