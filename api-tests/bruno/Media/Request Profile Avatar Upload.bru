meta {
  name: Request Profile Avatar Upload
  type: http
  seq: 2
}

post {
  url: {{base_url}}/media/uploads
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "purpose": "PROFILE_AVATAR",
    "fileName": "profile-avatar.webp",
    "contentType": "image/webp",
    "sizeBytes": 100000
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.mediaId) {
    bru.setEnvVar("media_id", res.body.mediaId);
    bru.setEnvVar("profile_avatar_media_id", res.body.mediaId);
    bru.setEnvVar("upload_url", res.body.uploadUrl);
    bru.setEnvVar(
      "media_content_type",
      res.body.requiredHeaders["Content-Type"]
    );
  }
}
