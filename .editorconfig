# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Don't edit files outside this directory

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches XML files
[*.xml]
indent_style = tab
indent_size = 4

# Matches YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Matches JSON and Markdown files
[*.{json,md}]
indent_style = space
indent_size = 2

# Windows batch files
[*.{cmd,bat}]
end_of_line = crlf
