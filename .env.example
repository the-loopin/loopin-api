# Server Pipeline Configuration
SERVER_PORT=8080

# PostgreSQL Database Credentials
DATABASE_URL=jdbc:postgresql://localhost:5432/loopin
DATABASE_USERNAME=loopin
DATABASE_PASSWORD=loopin
LIQUIBASE_ENABLED=true
LIQUIBASE_CONTEXTS=local
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Text Content Moderation Hardcoded Rules
BANNED_WORDS_LIST=scam,spam,offensiveword1,offensiveword2

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=local
RATE_LIMIT_KEY_PREFIX=loopin:rate-limit
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_PUBLIC_READ_REQUESTS=120
RATE_LIMIT_PUBLIC_READ_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_WRITE_REQUESTS=60
RATE_LIMIT_AUTHENTICATED_WRITE_WINDOW=1m
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security Configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long
CORS_ALLOWED_ORIGINS=*

# Loopin AI Microservice
LOOPIN_AI_BASE_URL=http://localhost:8000
LOOPIN_AI_TIMEOUT=10s

