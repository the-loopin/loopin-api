# Server
SERVER_PORT=8080
API_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
# Local JVM runs can use localhost; docker-compose overrides DATABASE_URL to use the postgres service hostname.
POSTGRES_DB=loopin
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/loopin
DATABASE_USERNAME=loopin
DATABASE_PASSWORD=loopin
LIQUIBASE_ENABLED=true
LIQUIBASE_CONTEXTS=local
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Google Client Id
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Text Content Moderation
BANNED_WORDS_LIST=scam,spam,offensiveword1,offensiveword2

# Optional AI Content Moderation (manual blocked-word checks always run first)
AI_MODERATION_ENABLED=false
AI_MODERATION_BASE_URL=
AI_MODERATION_ENDPOINT_PATH=/v1/moderation/check
AI_MODERATION_TIMEOUT=2s
AI_MODERATION_API_KEY=

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_KEY_PREFIX=loopin:rate-limit
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_PUBLIC_READ_REQUESTS=120
RATE_LIMIT_PUBLIC_READ_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_WRITE_REQUESTS=60
RATE_LIMIT_AUTHENTICATED_WRITE_WINDOW=1m
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_PORT=6379

# Security
JWT_SECRET=replace_with_at_least_32_bytes_of_random_secret_material
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
CORS_ALLOWED_ORIGINS=*
JWT_EXPIRATION=86400000

# Prometheus machine-to-machine scrape authentication. Use a long random value in production.
PROMETHEUS_SCRAPE_TOKEN=replace_with_a_long_random_prometheus_scrape_secret

# Loopin AI Microservice
LOOPIN_AI_BASE_URL=http://localhost:8000
LOOPIN_AI_TIMEOUT=2s
LOOPIN_AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PRESIGN_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=loopin-media
STORAGE_ACCESS_KEY=loopin-minio
STORAGE_SECRET_KEY=loopin-minio-local-password
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_UPLOAD_URL_TTL=10m

# MinIO Local Development
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=loopin-minio
MINIO_ROOT_PASSWORD=loopin-minio-local-password
# Pin a tested MinIO release in shared environments when needed. Docker Compose
# falls back to `latest` when this variable is omitted.
MINIO_IMAGE_TAG=latest

# Notification delivery through n8n
N8N_NOTIFICATIONS_ENABLED=false
N8N_NOTIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/loopin-notifications
N8N_NOTIFICATION_WEBHOOK_SECRET=replace_with_a_shared_webhook_secret
N8N_NOTIFICATION_TIMEOUT=5s
N8N_NOTIFICATION_BATCH_SIZE=50
N8N_NOTIFICATION_MAX_BACKOFF=1h
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key
